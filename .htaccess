# CapricEngine — Apache configuration (SiteGround/Plesk compatible)
# Requires: mod_rewrite, mod_headers, mod_deflate

Options -Indexes
DirectoryIndex index.html

# ---------------------------------------------------------------------------
# URL rewriting
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect www → non-www (optional, adjust to your domain)
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Pass existing files and directories through unchanged
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else → index.html (SPA fallback)
    RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# Cache headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    # JS / CSS / JSON → 1 week
    <FilesMatch "\.(js|css|json)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    </FilesMatch>

    # PHP → no-cache
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>

    # Images / fonts → 1 month
    <FilesMatch "\.(svg|png|jpg|jpeg|gif|ico|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# CORS for get_chord_data.php — same origin only
# ---------------------------------------------------------------------------
<Files "get_chord_data.php">
    <IfModule mod_headers.c>
        Header always set Access-Control-Allow-Origin "%{HTTP_HOST}e"
        Header always set Access-Control-Allow-Methods "GET"
        Header always set Access-Control-Allow-Headers "Content-Type"
    </IfModule>
</Files>

# ---------------------------------------------------------------------------
# Gzip compression for JS / CSS / JSON
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/javascript application/javascript
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/json text/plain
    AddOutputFilterByType DEFLATE text/html
</IfModule>

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
